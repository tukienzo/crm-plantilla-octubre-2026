# ═══════════════════════════════════════════════════════════════════════════════
#  Archivo de claves del CRM. Copialo a .env.local y completalo.
#  .env.local NUNCA va al repo (está en .gitignore). En Vercel se cargan las
#  mismas variables en Project → Settings → Environment Variables.
#  Las NEXT_PUBLIC_* se fijan al compilar: después de cambiarlas, reiniciá
#  `pnpm dev` o volvé a publicar.
#  Vacío = esa función queda apagada (excepto las marcadas OBLIGATORIA).
# ═══════════════════════════════════════════════════════════════════════════════

# ── Base (OBLIGATORIAS) ─────────────────────────────────────────────────────────
# Supabase → Project Settings → API. La service role NUNCA va en una NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=                         # opcional: si está vacía se usa NEXT_PUBLIC_SUPABASE_URL
SUPABASE_PROJECT_REF=                 # el ref del proyecto (lo de antes de .supabase.co); los crons lo exigen
CRON_SECRET=                          # cadena larga al azar (node scripts/instalar.mjs --generar-secretos)
NEXT_PUBLIC_APP_URL=http://localhost:3000   # en Vercel: la URL final del CRM
CRM_PUBLIC_URL=                       # opcional: URL que usan los crons para llamarse entre sí (default NEXT_PUBLIC_APP_URL)

# Solo para scripts (no hacen falta para correr la app):
SUPABASE_ACCESS_TOKEN=                # token personal de supabase.com/dashboard/account/tokens (scripts/aplicar-sql.mjs)

# ── Marca ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=Mi CRM         # nombre del negocio (menú, pestaña, login, avisos)
NEXT_PUBLIC_BRAND_SHORT_NAME=         # nombre corto para la app instalada (default: el nombre)
NEXT_PUBLIC_BRAND_TAGLINE=Centro de mando
NEXT_PUBLIC_BRAND_DESCRIPTION=CRM y centro de mando de la operación.
NEXT_PUBLIC_BRAND_IG_HANDLE=          # usuario de Instagram propio, sin @ (Radar, Ciudad, métricas, agendas)
NEXT_PUBLIC_BRAND_CTA_KEYWORD=INFO    # palabra clave que la gente comenta o manda por DM
NEXT_PUBLIC_BRAND_LEGAL_NAME=         # razón social (páginas /privacidad, /terminos, /eliminar-datos)
NEXT_PUBLIC_BRAND_CONTACT_EMAIL=      # mail de contacto de esas páginas (y de los avisos push)
NEXT_PUBLIC_BRAND_SITE=               # sitio público, sin https:// (ej. minegocio.com)

# ── Programa, precio y metas ─────────────────────────────────────────────────────
NEXT_PUBLIC_PROGRAMA_NOMBRE=Programa  # nombre del programa principal
NEXT_PUBLIC_PRECIO_BASE=              # precio de lista en USD, pago único (ej. 2000)
NEXT_PUBLIC_PROGRAMA_CUOTAS=          # planes en cuotas: "2x1000,3x700"
NEXT_PUBLIC_PROGRAMA_MESES=           # duración en meses (calcula la fecha de baja)
NEXT_PUBLIC_CRM_PROGRAMAS=            # opcional, varios programas en JSON (manda sobre lo de arriba; ver lib/programas.ts)
NEXT_PUBLIC_META_CASH_MENSUAL=        # meta mensual de cash collected en USD (Home, tablero, escalones de comisión)
PANEL_META_MENSUAL=                   # opcional: pisa la meta solo en el Panel del negocio
PANEL_PRECIO_BASE=                    # opcional: pisa el precio solo en el Panel del negocio
CRM_ESQUEMA_COMISIONES_DESDE=         # opcional (AAAA-MM): los meses anteriores usan el esquema de comisiones viejo por niveles

# ── Equipo ───────────────────────────────────────────────────────────────────────
# Quién entra y con qué rol sale de la tabla team_members (se aprueba en Accesos).
# Esto solo alimenta desplegables, rankings y la lectura de nombres cargados a mano.
NEXT_PUBLIC_CRM_CEO=                  # primer nombre del dueño o la dueña ("Ana")
NEXT_PUBLIC_CRM_SALES_MANAGER=        # primer nombre del responsable comercial (opcional)
NEXT_PUBLIC_CRM_CLOSERS=              # "Ana,Bruno"
NEXT_PUBLIC_CRM_SETTERS=              # "Carla,Diego"
NEXT_PUBLIC_CRM_SETTERS_HISTORICOS=   # ex-setters que siguen apareciendo en registros viejos ("Eva")
NEXT_PUBLIC_CRM_SETTERS_HISTORICOS_HASTA=   # hasta qué mes (AAAA-MM) se ofrecen los históricos
NEXT_PUBLIC_CRM_ALIAS=                # apodos: "anita=Ana;bru=Bruno"
NEXT_PUBLIC_CRM_CALENDARIO_GENERAL=   # nombre con el que llegan las agendas sin persona (default: el nombre de la marca)
NEXT_PUBLIC_CRM_FATHOM_NOMBRES=       # nombres completos del equipo para reconocer llamadas en Fathom ("ana perez,bruno gomez")
NEXT_PUBLIC_CRM_RESPONSABLES_CONTENIDO=   # responsables de Contenido ("Ana,Editor")
NEXT_PUBLIC_CRM_QUIEN_GRABA=          # quién graba las piezas (default: el primer responsable)
NEXT_PUBLIC_CRM_SOCIO_A=              # nombre visible del socio A en Finanzas (default "Socio A")
NEXT_PUBLIC_CRM_SOCIO_B=              # nombre visible del socio B en Finanzas (default "Socio B")
NEXT_PUBLIC_CRM_CON_PRECALLER=        # "1" si las agendas pasan por un precaller antes del closer
NEXT_PUBLIC_CRM_PRIMER_MES=           # primer mes del selector de períodos (AAAA-MM); default enero del año anterior
NEXT_PUBLIC_GRABAR_DESDE=             # opcional (AAAA-MM-DD): ventana fija de la vista "Grabar YA"
NEXT_PUBLIC_GRABAR_HASTA=             #   (vacías = de hoy a pasado mañana)

# ── Accesos y exportaciones ──────────────────────────────────────────────────────
CRM_CEO_NAMES=                        # opcional: limita el rol CEO a estos nombres (coma); el resto pasa a Sales Manager
AGENDA_EXPORT_EMAILS=                 # mails (coma) que pueden exportar agendas
PAYMENT_EXPORT_EMAILS=                # mails (coma) que pueden exportar pagos
CRM_INGEST_KEY=                       # clave para /api/ingest/* y /api/whatsapp-ingest (cargas externas)

# ── IA ───────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                    # Claude: asistente, guionista, setting, WhatsApp, Fathom, Radar, cierre diario
GROQ_API_KEY=                         # Whisper (transcripción de reels e historias del Radar)
OPENAI_API_KEY=                       # alternativa a Groq para transcribir

# ── Radar de contenido (Apify) ───────────────────────────────────────────────────
APIFY_TOKEN=                          # lee piezas, perfiles, historias y comentarios de Instagram
RADAR_PLAN=estandar                   # gratis | estandar | completo (frecuencia y gasto)
RADAR_TOPE_USD=                       # tope de gasto en Apify por corrida (default 3)
RADAR_MODELO=                         # modelo de Claude para el análisis (default en lib/radar/analisis.ts)
RADAR_MODELO_VOZ=                     # modelo de transcripción (default whisper-large-v3 en Groq)
# Ajustes finos (opcionales; los defaults están en lib/radar/*):
RADAR_ACTOR_PIEZAS=
RADAR_ACTOR_PERFILES=
RADAR_ACTOR_HISTORIAS=
RADAR_ACTOR_COMENTARIOS=
RADAR_INPUT_HISTORIAS=
RADAR_DIAS_PIEZAS=
RADAR_DIAS_MEDIOS=
RADAR_PIEZAS_POR_CUENTA=
RADAR_PIEZAS_COMENTARIOS=
RADAR_COMENTARIOS_POR_PIEZA=
RADAR_ANALISIS_POR_PASADA=
RADAR_TRANSCRIPCIONES_POR_PASADA=
RADAR_SECUENCIAS_POR_PASADA=
RADAR_SEGUNDOS=

# ── Meta (Ads, conversiones e Instagram) ─────────────────────────────────────────
META_ADS_ACCESS_TOKEN=                # token de usuario de sistema con ads_read
META_ADS_ACCOUNT_ID=                  # act_...
ADS_PALABRAS_WEBINAR=                 # palabras (coma) que marcan una campaña como de webinar (además de "webinar" y "masterclass")
META_CAPI_ACCESS_TOKEN=               # API de conversiones
META_CAPI_DATASET_ID=                 # id del píxel/dataset al que van los leads calificados
META_HAMMER_AUDIENCE_ID=              # público personalizado "tiene llamada agendada"
IG_INSIGHTS_TOKEN=                    # token con instagram_basic + instagram_manage_insights
IG_USER_ID=                           # id de la cuenta profesional de Instagram

# ── Ventas: agendas, contactos y llamadas ────────────────────────────────────────
ICLOSED_API_KEY=
ICLOSED_EVENT_IDS=                    # calendarios a importar (ids, coma); vacío = todos
MANYCHAT_API_KEY=
FATHOM_API_KEY=

# ── Google Sheets (espejo de pagos y agendas) ────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=          # JSON de la cuenta de servicio, en base64
GOOGLE_SHEET_ID=

# ── YouTube ──────────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=                   # UC...

# ── Finanzas (Mercury) ───────────────────────────────────────────────────────────
MERCURY_API_TOKEN=                    # solo lectura
MERCURY_PATRON_GASTO_PERSONAL=        # regex: comercios que son gastos personales de los socios
MERCURY_PATRON_RETIRO_SOCIOS=         # regex: contraparte de los retiros de utilidades

# ── Avisos push (se generan con node scripts/instalar.mjs --generar-secretos) ─────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                        # mailto:avisos@tudominio.com
